<?xml version="1.0"?>
<robot name="lilybot">

    <link name="base_footprint"/>

    <link name="base_link">
        <visual>
            <geometry>
                <cylinder radius="0.15" length="0.07"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.0976" rpy="0 0 0"/>
    </joint>

    <link name="laser">
        <visual>
            <geometry>
                <cylinder radius="0.025" length="0.018"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
    </link>

    <link name="laser_mount">
        <visual>
            <geometry>
                <box size="0.056 0.056 0.033"/>
            </geometry>
            <material name="grey">
                <color rgba="0.5 0.5 0.5"/>
            </material>
        </visual>
    </link>

    <joint name="laser_mount_joint" type="fixed">
        <parent link="base_link"/>
        <child link="laser_mount"/>
        <origin xyz="0 0 0.05155" rpy="0 0 0"/>
    </joint>

    <joint name="laser_joint" type="fixed">
        <parent link="laser_mount"/>
        <child link="laser"/>
        <origin xyz="0 0 0.02565" rpy="0 0 3.14159"/>
    </joint>

    <link name="wheel_1">
        <visual>
            <geometry>
                <cylinder radius="0.0375" length="0.025"/>
            </geometry>
        </visual>
        <material name="red">
            <color rgba="1 0 0 1"/>
        </material>
    </link>

    <!-- wheel 1 = front left -->
    <joint name="wheel_1_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_1"/>
        <origin xyz="0.06725 0.11648 -0.0601" rpy="1.5708 0 2.61799"/>
    </joint>

    <!-- wheel 2 = front right -->
    <link name="wheel_2">
        <visual>
            <geometry>
                <cylinder radius="0.0375" length="0.025"/>
            </geometry>
        </visual>
        <material name="red">
            <color rgba="1 0 0 1"/>
        </material>
    </link>

    <!-- wheel 3 = back -->
    <joint name="wheel_2_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_2"/>
        <origin xyz="0.06725 -0.11648 -0.0601" rpy="1.5708 0 0.52359"/>
    </joint>

    <link name="wheel_3">
        <visual>
            <geometry>
                <cylinder radius="0.0375" length="0.025"/>
            </geometry>
        </visual>
        <material name="red">
            <color rgba="1 0 0 1"/>
        </material>
    </link>

    <joint name="wheel_3_joint" type="continuous"> 
        <parent link="base_link"/>
        <child link="wheel_3"/>
        <origin xyz="-0.1345 0.0 -0.0601" rpy="1.5708 0 -1.5708"/> 
    </joint>

</robot>